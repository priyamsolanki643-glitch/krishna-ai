# ============================================================
# Omni-Nexus / Krishna AI — Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# Variables marked [REQUIRED] must be set for the app to start.
# Variables marked [OPTIONAL] have fallbacks or graceful degradation.
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=8080                          # [OPTIONAL] Default: 8080
NODE_ENV=development               # [OPTIONAL] development | production | test

# ── Database (Supabase PostgreSQL) ───────────────────────────
DATABASE_URL=postgresql://...      # [REQUIRED] Supabase connection string (with pgvector)
SUPABASE_URL=https://xxx.supabase.co  # [OPTIONAL] Supabase project URL
SUPABASE_ANON_KEY=eyJ...           # [OPTIONAL] Supabase anonymous public key
SUPABASE_SERVICE_KEY=eyJ...        # [OPTIONAL] Supabase service role key (for admin ops)

# ── Redis (Upstash) ─────────────────────────────────────────
UPSTASH_REDIS_REST_URL=            # [OPTIONAL] Falls back to in-memory cache
UPSTASH_REDIS_REST_TOKEN=          # [OPTIONAL] Falls back to in-memory cache

# ── Authentication ───────────────────────────────────────────
JWT_SECRET=your-super-secret-key   # [REQUIRED] Min 32 chars for HS256
JWT_EXPIRES_IN=7d                  # [OPTIONAL] Default: 7d
OTP_EXPIRY_MINUTES=10              # [OPTIONAL] Default: 10 minutes
OTP_COOLDOWN_SECONDS=60            # [OPTIONAL] Default: 60 seconds between OTP sends
ADMIN_SECRET=admin-secret-key      # [OPTIONAL] For admin endpoint access

# ── LLM Providers (at least one REQUIRED) ────────────────────
# Groq — PRIMARY (user has this key)
GROQ_API_KEYS=gsk_xxx,gsk_yyy     # [REQUIRED] Comma-separated for key rotation

# Google Gemini — OPTIONAL (plug-and-play)
GEMINI_API_KEYS=                   # [OPTIONAL] Comma-separated

# OpenAI — OPTIONAL (plug-and-play)
OPENAI_API_KEY=                    # [OPTIONAL]

# Anthropic (Claude) — OPTIONAL (plug-and-play)
ANTHROPIC_API_KEY=                 # [OPTIONAL]

# DeepSeek — OPTIONAL (plug-and-play)
DEEPSEEK_API_KEY=                  # [OPTIONAL]

# ── Embedding Model ─────────────────────────────────────────
EMBEDDING_PROVIDER=groq            # [OPTIONAL] groq | openai | gemini
EMBEDDING_MODEL=llama-3.3-70b-versatile  # [OPTIONAL] Model for embeddings
EMBEDDING_DIMENSIONS=1536          # [OPTIONAL] Vector dimensions (1536 default)

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_REQUESTS=60             # [OPTIONAL] Max requests per window
RATE_LIMIT_WINDOW_SECONDS=60       # [OPTIONAL] Window size in seconds

# ── Tool Execution ───────────────────────────────────────────
TAVILY_API_KEY=                    # [OPTIONAL] For web search tool
BRAVE_SEARCH_API_KEY=              # [OPTIONAL] Alternative web search
SERP_API_KEY=                      # [OPTIONAL] Alternative web search

# ── Object Storage ───────────────────────────────────────────
STORAGE_PROVIDER=supabase          # [OPTIONAL] supabase | s3 | r2
S3_BUCKET=                         # [OPTIONAL] S3/R2 bucket name
S3_REGION=                         # [OPTIONAL] S3 region
S3_ACCESS_KEY=                     # [OPTIONAL]
S3_SECRET_KEY=                     # [OPTIONAL]

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info                     # [OPTIONAL] trace | debug | info | warn | error | fatal
