# Groq API Key (required)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Tavily API Key for Live Web Research (primary)
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# Google Gemini API Key for Grounded Search (fallback)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# PostgreSQL Database URL (Neon/Supabase/CloudSQL)
DATABASE_URL=postgresql://username:password@ep-cool-pool-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Port configuration (Cloud Run provides PORT automatically)
PORT=8080
NODE_ENV=production
