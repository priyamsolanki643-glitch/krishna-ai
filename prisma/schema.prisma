// datasource: postgresql with pgvector extension
// generator: prisma-client-js with postgresqlExtensions preview feature

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ENUMS

enum Role {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum ModelTier {
  FAST
  THINKING
  CREATIVE
}

enum OTPStatus {
  PENDING
  VERIFIED
  EXPIRED
}

enum MentorPersona {
  VISIONARY
  DRILL_SERGEANT
  ACCOUNTABILITY_PARTNER
  CRISIS_SUPPORT
}

enum PathType {
  FAST_PATH
  DEEP_PATH
}

// MODELS

/// Represents a user of the Omni-Nexus system
model User {
  id                    String                @id @default(uuid())
  email                 String                @unique
  name                  String?
  passwordHash          String?
  apiKey                String?               @unique
  tier                  String                @default("free")
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  workspaces            Workspace[]
  sessions              Session[]
  memories              Memory[]
  otps                  OTP[]
  cognitiveFingerprint  CognitiveFingerprint?
  consistencyLogs       ConsistencyLog[]
}

/// Represents a workspace containing sessions and other context
model Workspace {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions    Session[]

  @@index([userId])
}

/// Represents an interaction session or conversation
model Session {
  id              String         @id @default(uuid())
  userId          String
  workspaceId     String?
  title           String         @default("New Conversation")
  modelTier       ModelTier      @default(THINKING)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace       Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  messages        Message[]
  artifacts       Artifact[]
  councilSessions CouncilSession[]

  @@index([userId])
  @@index([workspaceId])
}

/// Represents a single message within a session
model Message {
  id          String   @id @default(uuid())
  sessionId   String
  role        Role
  content     String   @db.Text
  reasoning   String?  @db.Text
  tokenUsage  Json?
  toolCalls   Json?
  createdAt   DateTime @default(now())

  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

/// Represents a long-term memory for a user
model Memory {
  id          String   @id @default(uuid())
  userId      String
  content     String   @db.Text
  embedding   Unsupported("vector(1536)")?
  category    String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Represents a generated file or structured output
model Artifact {
  id          String   @id @default(uuid())
  sessionId   String
  filename    String
  fileType    String
  contentUrl  String?
  inlineData  String?  @db.Text
  version     Int      @default(1)
  createdAt   DateTime @default(now())

  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

/// Represents a One-Time Password for authentication
model OTP {
  id            String    @id @default(uuid())
  email         String
  hashedOtp     String
  attempts      Int       @default(0)
  status        OTPStatus @default(PENDING)
  expiresAt     DateTime
  cooldownUntil DateTime?
  createdAt     DateTime  @default(now())
  
  userId        String?
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, status])
}

/// Represents a user's cognitive profile and learning traits
model CognitiveFingerprint {
  id                      String   @id @default(uuid())
  userId                  String   @unique
  learningStyle           String
  technicalLevel          Int
  communicationPreference String
  missedConcepts          Json?
  strengths               Json?
  consistencyScore        Float    @default(0)
  streakDays              Int      @default(0)
  activeDays              Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Represents a multi-agent council session
model CouncilSession {
  id                String          @id @default(uuid())
  sessionId         String
  agents            Json
  stages            Json
  finalAnswer       String?         @db.Text
  telemetry         Json?
  pathType          PathType        @default(FAST_PATH)
  mentorPersona     MentorPersona?
  omniLayerResults  Json?
  createdAt         DateTime        @default(now())

  session           Session         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  debateLogs        DebateLog[]

  @@index([sessionId])
}

/// Represents a single debate log entry inside a council session
model DebateLog {
  id               String         @id @default(uuid())
  councilSessionId String
  round            Int
  agentRole        String
  position         String
  argument         String         @db.Text
  counterpoints    Json?
  createdAt        DateTime       @default(now())

  councilSession   CouncilSession @relation(fields: [councilSessionId], references: [id], onDelete: Cascade)

  @@index([councilSessionId])
}

/// Tracks the user's interaction consistency over time
model ConsistencyLog {
  id          String   @id @default(uuid())
  userId      String
  date        DateTime
  score       Float
  metrics     Json?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}
